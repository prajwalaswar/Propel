# Copy to .env and adjust. Defaults run in replay mode with NO API key.

# replay = fixtures, no network, no key (default). live = call Gemini/Groq.
LLM_MODE=replay

# Only needed when LLM_MODE=live:
# GEMINI_API_KEY=your_google_ai_studio_key
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_API_KEY=your_groq_key
# GROQ_MODEL=llama-3.3-70b-versatile

# Reliability / policy knobs (sensible defaults shown)
# REFUND_HUMAN_APPROVAL_THRESHOLD_INR=1000
# REFUND_WINDOW_DAYS=7
# LOW_CONFIDENCE_THRESHOLD=0.55
# MAX_CONCURRENT_LLM_CALLS=8

# Logging
LOG_LEVEL=INFO
LOG_JSON=true
